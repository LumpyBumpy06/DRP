# =========================
# APP
# =========================
DATABASE_TYPE=sqlite  # sqlite | postgres

# =========================
# DATABASE CONFIG
# =========================

# Local SQLite fallback (used when APP_ENV=local and no Postgres provided)
SQLITE_FILE=dev.db

# Postgres (used in local docker or kubernetes)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

#Firebase credentials
FIREBASE_CREDENTIALS_FILE=secrets/firebase-auth-credentials.json

# =========================
# BLOCK STORAGE (MinIO / S3)
# =========================
# Which store to use: "local" (dockerised MinIO, see docker-compose.yml) or
# "deployment" (the cluster's MinIO — set MINIO_DEPLOYMENT_ENDPOINT to a
# reachable address, e.g. a kubectl port-forward or external route).
STORAGE_TARGET=local              # local | deployment

MINIO_LOCAL_ENDPOINT=localhost:9008
MINIO_DEPLOYMENT_ENDPOINT=        # e.g. localhost:9000 via port-forward, or minio.<host>

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false               # true when the endpoint is served over HTTPS
MINIO_BUCKET=audio-files         # S3 bucket names must be lowercase (no "audioFiles")
